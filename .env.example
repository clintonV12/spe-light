# StratPlan / SPE-Light environment configuration
# Local dev values — matches docker-compose.yml + Makefile DB_URL defaults.
# Shell environment variables always take priority over this file (godotenv).

# ── Server ────────────────────────────────────────────────────────────────
PORT=8082
APP_ENV=development
APP_URL=http://localhost:8082
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────
# Matches docker-compose.yml postgres service (user/pass/db = stratplan)
# and the Makefile's DB_URL default for migrate-up/down.
# If running the app OUTSIDE docker compose (e.g. `go run ./cmd/server`
# while postgres runs in Docker), host stays "localhost" since port 5432
# is published. If running the app itself INSIDE compose, this gets
# overridden by docker-compose.yml's `environment.DATABASE_URL` (host: postgres).
DATABASE_URL=postgres://stratplan:stratplan@localhost:5432/stratplan?sslmode=disable

# ── JWT ───────────────────────────────────────────────────────────────────
# Required in production; must be 32+ chars or config.Load() will error.
# Generate a real one with: openssl rand -base64 32
JWT_SECRET=dev-secret-change-before-deploying-32chars!!
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=30

# ── Ollama (self-hosted AI — Sprint C) ──────────────────────────────────
# If running the app outside docker compose, localhost:11434 works since
# docker-compose.yml publishes that port. Inside compose, OLLAMA_URL is
# overridden to http://ollama:11434 automatically.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Overdue notifier (background job — internal/jobs/overdue_notifier.go) ──
# Started as a goroutine from cmd/server/main.go, not per-request. Scans for
# activities past their due_date and emails whoever's assigned (falling back
# to the plan owner if nobody is) via the existing overdue_alert email
# template. Both values are Go duration strings (e.g. "15m", "2h").
#
# OVERDUE_SCAN_INTERVAL  — how often to re-scan for newly-overdue activities.
# OVERDUE_NOTIFY_COOLDOWN — once someone's been emailed about a given
#   activity, how long before they can be emailed about that same activity
#   again (it's still overdue, but nobody wants a fresh email every 30 min).
OVERDUE_SCAN_INTERVAL=30m
OVERDUE_NOTIFY_COOLDOWN=24h

# ── SMTP ──────────────────────────────────────────────────────────────────
# Leave SMTP_HOST=localhost and SMTP_USER empty to log emails to stdout
# instead of sending them — convenient for local development.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@stratplan.local

# ── Seed script (cmd/seed) ─────────────────────────────────────────────────
# Not read by config.go / Config struct, but used directly by
# cmd/seed/main.go to bootstrap the first super_admin. Optional — the
# seed script has its own defaults if these are left unset.
# SEED_EMAIL=admin@stratplan.local
# SEED_PASSWORD=change-me-please