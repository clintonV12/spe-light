# ============================================================================

# SPE-Light Environment Configuration

# Copy this file to .env and update the values.

# ============================================================================

# ----------------------------------------------------------------------------

# Application

# ----------------------------------------------------------------------------

APP_ENV=development
PORT=8080

# Backend public URL

APP_URL=http://localhost:8080

# Frontend URL (future use for email links, redirects, etc.)

FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------------------

# PostgreSQL

# ----------------------------------------------------------------------------

DATABASE_URL=postgres://clinton:postgres123@localhost:5432/spe_lite?sslmode=disable

# ----------------------------------------------------------------------------

# JWT Authentication

# ----------------------------------------------------------------------------

# MUST be at least 32 characters

JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters

# Access token lifetime (minutes)

JWT_ACCESS_EXPIRY_MIN=15

# Refresh token lifetime (days)

JWT_REFRESH_EXPIRY_DAYS=30

# ----------------------------------------------------------------------------

# Ollama AI

# ----------------------------------------------------------------------------

OLLAMA_URL=http://localhost:11434

# Examples:

# llama3

# llama3.1

# mistral

# qwen3

OLLAMA_MODEL=llama3

# ----------------------------------------------------------------------------

# SMTP Email

# ----------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USER=[your-email@example.com](mailto:your-email@example.com)
SMTP_PASSWORD=your-app-password

SMTP_FROM=[noreply@spe-light.com](mailto:noreply@spe-light.com)

# ----------------------------------------------------------------------------

# Future Integrations (Reserved)

# ----------------------------------------------------------------------------

# Stripe

# STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET=

# S3 / Object Storage

# S3_ENDPOINT=

# S3_ACCESS_KEY=

# S3_SECRET_KEY=

# S3_BUCKET=

# Monitoring

# SENTRY_DSN=
