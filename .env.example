# StratPlan environment configuration
# Copy this file to .env and fill in real values before running locally.
# Shell environment variables always take priority over .env.

# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=development
APP_URL=http://localhost:8080

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://clinton:postgres123@localhost:5432/spe_lite?sslmode=disable

# ── JWT ───────────────────────────────────────────────────────────────────
# Required in production. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
JWT_SECRET=dev-secret-change-before-deploying-32chars!!
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=30

# ── Ollama (self-hosted AI — Sprint 3+) ──────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── SMTP ──────────────────────────────────────────────────────────────────
# Leave SMTP_HOST=localhost and SMTP_USER empty to log emails to stdout
# instead of sending them — convenient for local development.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@stratplan.local